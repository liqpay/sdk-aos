<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ProgressBar
            android:visibility="invisible"
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/p24_margin_normal"
            tools:context=".GooglePayTokenExampleActivity">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1: Initialization with Data and Signature\nAlso this step retrieves merchant id which is necessary for Google Pay token retrieval" />

            <Button
                android:id="@+id/bInit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p24_margin_xSmall"
                android:text="Init" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p24_margin_normal"
                android:text="Step 2: Merchant has to manually obtain Google Pay Token with help of Google Wallet Sdk " />

            <EditText
                android:text=""
                android:id="@+id/etGooglePayToken"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p24_margin_xSmall"
                android:enabled="false"
                android:hint="Google Pay Token" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p24_margin_normal"
                android:text="Step 3: We send Google Pay Token along with response from step 1 for payment method" />

            <Button
                android:id="@+id/bPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p24_margin_xSmall"
                android:enabled="false"
                android:text="Pay with Google Pay Token" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>

